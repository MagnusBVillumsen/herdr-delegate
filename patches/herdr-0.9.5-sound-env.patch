+    /// Whether the pane's process was launched with `HERDR_SOUND=off`.
+    fn pane_sound_muted(&self, pane_id: crate::layout::PaneId) -> bool {
+        self.app
+            .state
+            .workspaces
+            .iter()
+            .find_map(|ws| {
+                ws.tabs.iter().find_map(|tab| {
+                    let pane = tab.panes.get(&pane_id)?;
+                    self.app
+                        .terminal_runtimes
+                        .get(&pane.attached_terminal_id)?
+                        .child_pid()
+                })
+            })
+            .is_some_and(crate::platform::process_sound_muted)
+    }
+
     fn forward_semantic_agent_notification(
         &mut self,
         update: &crate::app::actions::PaneStateUpdate,
